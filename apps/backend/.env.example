# Database Configuration
MONGODB_URI=mongodb://localhost:27017/emergency_dispatch

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Mobile App Configuration (Expo)
# Add your IP addresses here when using mobile app (comma-separated, no spaces)
# To find your IP: Windows: ipconfig | Mac/Linux: ifconfig
# Examples: 192.168.1.101,172.20.10.3,10.0.0.5
MOBILE_IPS=

# Email Configuration (for password reset - to be implemented)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Application Settings
APP_NAME=Emergency Dispatch System